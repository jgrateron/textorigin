# =============================================================================
#  TextOrigin · Variables de entorno para Docker Compose
#
#  1. Copia este archivo:   cp .env.example .env
#  2. Escribe tu clave de DeepSeek en DEEPSEEK_API_KEY.
#  3. Arranca con:          make up    (o  docker compose up -d)
#
#  El archivo .env está en .gitignore y nunca se sube al repositorio.
#  Este archivo de ejemplo SÍ se versiona, pero no contiene ninguna clave real.
# =============================================================================

# --- Obligatoria ---------------------------------------------------------
# Clave de API de DeepSeek: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-tu-clave-aqui

# --- Opcionales (si se omiten, se usan los valores por defecto) ----------
# Etiqueta de la imagen (latest o una versión concreta, por ejemplo 1.0.0)
# TEXTOORIGIN_VERSION=latest

# Análisis permitidos por IP y día
# MAX_PER_IP_PER_DAY=10

# Peticiones simultáneas a DeepSeek
# CONCURRENT_SEGMENTS=5

# Modelo de DeepSeek
# DEEPSEEK_MODEL=deepseek-chat
